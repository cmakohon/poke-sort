# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build output
/build
dist/
**/.turbo/**
*.tsbuildinfo

# packaged desktop app
packages/desktop/release/

# bundled SigLIP weights, fetched by packages/desktop/scripts/fetch-model.mjs
/.models

# local app data (embedded db + scan captures)
.poke-sort/

# Phase 0 spikes - not committed
/scratch

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# server deploy bundle for packaging (pnpm deploy output)
packages/desktop/.server-bundle/

# eval fixture images (regenerate with `pnpm eval:build`)
packages/server/eval/fixtures/

# full-catalog build (background job)
packages/server/.poke-sort-catalog/

# tesseract language data, downloaded on first OCR run
*.traineddata

# captured eval signals (regenerate with `pnpm eval:capture`)
packages/server/eval/signals.json
