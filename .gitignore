# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build output
/build
dist/
**/.turbo/**
*.tsbuildinfo

# packaged desktop app
packages/desktop/release/

# bundled SigLIP weights, fetched by packages/desktop/scripts/fetch-model.mjs
/.models

# local app data (embedded db + scan captures)
#
# Glob, not an exact directory: a data directory acquires siblings — a
# .poke-sort-catalog for the full catalog, a .poke-sort-catalog.backup before
# surgery on one — and an exact pattern silently leaves those committable. A
# 314 MB Postgres data directory in `git add -A` is not a mistake you make
# twice.
.poke-sort*

# Phase 0 spikes - not committed
/scratch

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# server deploy bundle for packaging (pnpm deploy output)
packages/desktop/.server-bundle/

# eval fixture images (regenerate with `pnpm eval:build`)
packages/server/eval/fixtures/

# tesseract language data, downloaded on first OCR run
*.traineddata

# captured eval signals (regenerate with `pnpm eval:capture`)
packages/server/eval/signals*.json

# per-probe OCR sweep dumps (regenerate with `eval/ocr-sweep.ts`)
packages/server/eval/.sweep/

# art-crop probe cache: catalog renders + vectors (regenerate with
# `eval/art-crop-probe.ts`; it re-downloads and re-embeds on a cold cache)
packages/server/eval/.artprobe/
