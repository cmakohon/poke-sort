{
  "name": "@magic-vault/server",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists ../../.env src/index.ts",
    "build": "tsup",
    "db:generate": "drizzle-kit generate",
    "db:socket": "pglite-server --db ./.mault/db --port 5432",
