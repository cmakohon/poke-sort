{
  "name": "@poke-sort/server",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists ../../.env src/index.ts",
    "build": "tsup",
    "db:generate": "drizzle-kit generate",
    "db:socket": "pglite-server --db \"${POKE_SORT_DATA_DIR:-./.poke-sort}/db\" --port 5432",
    "db:studio": "drizzle-kit studio",
    "calibration": "tsx --env-file-if-exists ../../.env scripts/calibration.ts",
    "export:pack": "tsx --env-file-if-exists ../../.env scripts/export-pack.ts",
    "eval:accuracy": "POKE_SORT_DATA_DIR=${POKE_SORT_DATA_DIR:-./.poke-sort-catalog} POKE_SORT_MODEL_DIR=${POKE_SORT_MODEL_DIR:-../../.models} vitest run eval/accuracy.test.ts --disableConsoleIntercept",
    "eval:build": "POKE_SORT_DATA_DIR=${POKE_SORT_DATA_DIR:-./.poke-sort-catalog} tsx eval/build-fixtures.ts",
    "eval:capture": "POKE_SORT_DATA_DIR=${POKE_SORT_DATA_DIR:-./.poke-sort-catalog} POKE_SORT_MODEL_DIR=${POKE_SORT_MODEL_DIR:-../../.models} tsx eval/capture-signals.ts",
    "eval:tune": "tsx eval/tune.ts",
    "test": "vitest run --exclude '**/accuracy.test.ts'",
    "eval:hnsw": "POKE_SORT_DATA_DIR=${POKE_SORT_DATA_DIR:-./.poke-sort-catalog} POKE_SORT_MODEL_DIR=${POKE_SORT_MODEL_DIR:-../../.models} tsx eval/hnsw-recall.ts",
    "db:status": "tsx scripts/db-status.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@electric-sql/pglite-pgvector": "^0.0.5",
    "@hono/node-server": "^1.19.9",
    "@huggingface/transformers": "^3.8.1",
    "@poke-sort/shared": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.2",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.7",
    "@types/node": "^20",
    "drizzle-kit": "^0.31.9",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
