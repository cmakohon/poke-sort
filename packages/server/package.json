    "@magic-vault/shared": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.7",
    "@types/node": "^20",
    "drizzle-kit": "^0.31.9",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5"
