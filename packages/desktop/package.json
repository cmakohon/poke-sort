{
  "name": "@poke-sort/desktop",
  "version": "1.2.0",
  "private": true,
  "description": "PokeSort — Pokémon card scanner and physical sorter",
  "author": "Collin Makohon",
  "homepage": "https://github.com/cmakohon/poke-sort",
  "repository": {
    "type": "git",
    "url": "https://github.com/cmakohon/poke-sort.git"
  },
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsup",
    "dev": "pnpm -w run build && electron dist/main.cjs",
    "dev:catalog": "pnpm dev",
    "icons": "node scripts/generate-icons.mjs",
    "fetch:model": "node scripts/fetch-model.mjs",
    "bundle:server": "node scripts/bundle-server.mjs",
    "dist": "pnpm -w run build && pnpm bundle:server && electron-builder --publish never",
    "dist:dir": "pnpm -w run build && pnpm bundle:server && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@types/node": "^20",
    "electron": "^43.3.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.34.5",
    "tsup": "^8.4.0",
    "typescript": "^5"
  }
}
